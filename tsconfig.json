{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "games/*/src", "games/*/tests", "games/*/scripts", "games/*/e2e", "games/*/vite.config.ts", "games/*/playwright.config.ts",
    "packages/*/src", "packages/*/tests", "packages/*/gallery",
    "server/src", "server/tests", "vitest.config.ts"
  ]
}
