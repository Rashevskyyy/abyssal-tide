{
  "name": "slotkit",
  "version": "1.0.0",
  "description": "Slot games in TypeScript, PixiJS and GSAP built on one shared kit (@slotkit/*) and one game server.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "games/*",
    "server"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pg": "DATABASE_URL=${DATABASE_URL:-postgres://postgres@127.0.0.1:5433/abyssal} vitest run server/tests",
    "server": "npm run dev -w @abyssal-tide/server",
    "abyssal": "npm run dev -w @games/abyssal-tide",
    "gallery": "npm run gallery -w @slotkit/symbols-cyanotype",
    "gallery:build": "npm run gallery:build -w @slotkit/symbols-cyanotype"
  },
  "devDependencies": {
    "@assetpack/core": "^1.7.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  }
}
